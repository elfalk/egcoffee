# ==============================================================================
# Egyptian Coffee Trade (egcoffee.pro) - Environment Variables Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# Never commit real API keys or tokens to Git.
# Private tokens MUST NOT use the VITE_ prefix.
# ==============================================================================

# 1. Server-Side Private Credentials (Used only in Express / Vercel API Routes)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
BASE44_API_TOKEN="YOUR_BASE44_API_TOKEN"
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# 2. Public Client-Side Configuration (Safe to expose via VITE_ prefix)
VITE_BASE44_API_URL="https://egcoffee.base44.app/api"
VITE_BASE44_APP_ID="6ae1356b20aa9cddb1240b85"
APP_URL="https://www.egcoffee.pro"

# Note: Google Tag Manager (GTM-T2KCKDLR) is already installed in index.html,
# and Meta Pixel (1135528898886821) is already managed inside GTM-T2KCKDLR.
# No VITE_GTM_ID or VITE_META_PIXEL_ID environment variables are required.
