# Egyptian Coffee Trade — environment variables
# Copy to `.env.local` for local development. Never commit real values.

# Base44 (server-side only — do NOT prefix with VITE_)
BASE44_API_TOKEN=your_base44_api_token_here
BASE44_API_URL=https://egcoffee.base44.app/api
BASE44_APP_ID=your_base44_app_id_here

# Telegram admin notifications (server-side only)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Google Gemini (server-side only, used by /api/analyze-blend)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: only set a VITE_-prefixed Base44 token if you deliberately want a
# public client credential. Leaving it empty is the secure default; all data
# requests then go through the server proxy.
# VITE_BASE44_API_TOKEN=
